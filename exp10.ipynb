   "source": [
    "#count the occurrances of each word ina line of text\n",
    "text = input(\"enter a line of text : \")\n",
    "words = text.split()\n",
    "count = {}\n",
    "for word in words:\n",
    "    count[word] = count.get(word, 0) + 1\n",
    "print(\"word occurrences:\", count)"
   ]
